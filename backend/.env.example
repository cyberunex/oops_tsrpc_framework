# 服务器环境配置
NODE_ENV=development

# 服务端口
PORT=3000

# MongoDB 配置
MONGODB_URI=mongodb://admin:GamePlatform2024!@localhost:27017/game_platform?authSource=admin

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=game_user
MYSQL_PASSWORD=GameUser2024!
MYSQL_DATABASE=game_platform

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 配置
JWT_SECRET=YourSuperSecretJWTKey2024!ChangeInProduction
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 日志配置
LOG_LEVEL=debug
LOG_DIR=logs

# CDN 配置
CDN_URL=https://cdn.example.com

# 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
